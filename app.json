{
  "expo": {
    "name": "FORM",
    "slug": "form-workout",
    "version": "1.0.0",
    "scheme": "formworkout",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.formworkout.personal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.formworkout.personal"
    },
    "web": {
      "name": "FORM",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an exercise image for your private workout library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ]
  }
}
