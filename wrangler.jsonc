{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
